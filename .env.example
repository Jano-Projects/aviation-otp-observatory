# Local settings. "python tasks.py up" copies this file to .env the first time.
# .env is git-ignored: never commit real passwords.
# Avoid the characters  @  /  "  and spaces in passwords.

# Password for SYS/SYSTEM inside the container
ORACLE_PASSWORD=Oracle_Sys_2026

# Password for the application schema OTP
OTP_PASSWORD=Otp_App_2026

# Host port for the database (change it if 1521 is already in use)
ORACLE_PORT=1521

# utPLSQL version (git tag) used for unit tests
UTPLSQL_VERSION=v3.1.14
